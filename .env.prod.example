# CyberCareer — production environment.
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod            # it holds every secret this deployment has
#
# Then:  docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# .env.prod must never be committed. Check .gitignore covers it before your first
# commit after creating it.

# ── Domains ────────────────────────────────────────────────────────────────
# Both must already resolve to this server's public IP, or Caddy cannot obtain a
# certificate. Do the DNS first and let it propagate.
APP_DOMAIN=careerai.example.de
AUTH_DOMAIN=auth.careerai.example.de

# Where Let's Encrypt sends expiry warnings. A real address you read.
ACME_EMAIL=you@example.de

# ── Keycloak database ──────────────────────────────────────────────────────
# Not reachable from outside the Docker network, but a weak password here is
# still a weak password. Generate one:  openssl rand -base64 32
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=

# ── Keycloak first-boot admin ──────────────────────────────────────────────
# Used only to create the initial administrator. Sign in, change the password,
# then delete these two lines and restart — they are visible to anyone who can
# run `docker inspect` on the host.
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=

# ── OIDC client ────────────────────────────────────────────────────────────
# Created inside Keycloak after the first start — see docs/DEPLOYMENT.md step 5.
# The realm name must match KC_REALM.
KC_REALM=careerai
OIDC_KEYCLOAK_CLIENT_ID=careerai-web
OIDC_KEYCLOAK_CLIENT_SECRET=

# Shown on the sign-in button. Keep it neutral: your users do not care that the
# identity server is called Keycloak, and the name is misleading once it brokers
# Google and GitHub.
OIDC_KEYCLOAK_LABEL=Single sign-on

# Identity is delegated entirely to Keycloak: no local passwords, one place where
# accounts are administered. Remove this line to also allow local accounts.
AUTH_MODE=oidc-only

# Usernames granted the Admin page. Under oidc-only this is the provider's
# preferred_username, not a local name.
ADMIN_USERS=

# ── Application secrets ────────────────────────────────────────────────────
# Only what you actually use. Every one is optional; without a key the matching
# feature degrades to a template or keyword fallback instead of failing.
ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Sending mail from the app itself. Keycloak has its OWN SMTP settings, configured
# in its admin console — this key does not reach it.
RESEND_API_KEY=
# RESEND_FROM=CareerAI <noreply@careerai.example.de>

# Job sources.
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# JOOBLE_API_KEY=
# APIFY_TOKEN=

# ── Exposure ───────────────────────────────────────────────────────────────
# Job search is public by default so a visitor can see what the app does before
# signing up. Set to 0 to require an account for that too.
# PUBLIC_JOB_SEARCH=1

# NEVER set ALLOW_INSECURE_TLS here. The server refuses to start with it under
# NODE_ENV=production, which is what the production image sets.
